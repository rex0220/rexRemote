<Window x:Class="RexRemote.App.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mac にログイン"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=UserNameBox}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TargetText" Grid.ColumnSpan="2" Margin="0,0,0,12" TextWrapping="Wrap" />

        <Label Grid.Row="1" Content="ユーザー名(_U)" Target="{Binding ElementName=UserNameBox}" VerticalAlignment="Center" />
        <TextBox x:Name="UserNameBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Height="30" />

        <Label Grid.Row="2" Content="パスワード(_P)" Target="{Binding ElementName=PasswordBox}" VerticalAlignment="Center" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Height="30" />

        <CheckBox x:Name="SavePasswordCheckBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource ToggleSwitch}"
                  Content="パスワードを保存する(_S)"
                  ToolTip="認証に成功したら Windows 資格情報マネージャーに保存し、次回から入力を省略します" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="接続" MinWidth="88" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" />
            <Button Content="キャンセル" MinWidth="88" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
