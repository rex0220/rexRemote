<Window x:Class="RexRemote.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rexRemote - ヘルプ"
        Width="680" Height="760" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" Background="White">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,16,2" />
        </Style>
        <!-- 選択してコピーできるパス表示 -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ログのフォルダを開く" Padding="14,0" Click="OnOpenLogFolder" />
                <Button Content="閉じる" Style="{StaticResource AccentButton}" MinWidth="88" Margin="8,0,0,0"
                        IsDefault="True" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
            <StackPanel>
                <TextBlock Text="rexRemote" FontSize="26" FontWeight="SemiBold" Foreground="#1A1A1A" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Body}" Foreground="#6E6E6E" />
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0">
                    Windows から macOS の「画面共有」に接続する VNC クライアントです。
                    Apple Remote Desktop 認証（macOS のユーザー名とパスワード）で接続します。
                </TextBlock>

                <TextBlock Text="接続" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}">・ホストに Mac の名前（例: mac-mini）または IP アドレス、ポートは通常 5900。接続に成功した接続先は一覧から選べます（✕ で削除）。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・「パスワードを保存する」を選ぶと Windows 資格情報マネージャーに保存し、次回から入力を省略します。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・回線の瞬断などで切れたときは自動で再接続します（⚙ でオン／オフ）。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・暗号化されるのはログイン時の資格情報だけで、画面やキー入力は暗号化されません。Tailscale や SSH トンネル経由で使ってください。</TextBlock>

                <TextBlock Text="キーボード" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}">リモート画面をクリックしてフォーカスがある間、キーは Mac に送られます。</TextBlock>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Key}" Text="Win" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Body}" Text="Command（Win+C / Win+V でコピー・貼り付け、Win+Tab でアプリ切り替え、Win+Space で Spotlight）" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Alt" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="Option" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Ctrl ⇔ Cmd 入れ替え" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" Text="⚙ でオンにすると、Ctrl が Command、Win が Control になります（Ctrl+C / Ctrl+V が Mac のコピー・貼り付けになる）" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Ctrl+Space" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}" Text="Mac の入力ソース（ABC ⇔ 日本語）の切り替え（Mac の標準ショートカット）" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Key}" Text="Caps Lock" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Body}" Text="Windows 側で大文字ロックとして働きます（Mac には送りません）" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Key}" Text="PrintScreen" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Body}" Text="Windows のスクリーンショット（Mac には送りません）" />
                    <TextBlock Grid.Row="6" Style="{StaticResource Key}" Text="Windows に戻る" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Body}" Text="接続中は Win キーや Alt+Tab も Mac に送るので、マウスでタスクバーなどをクリックしてください" />
                </Grid>

                <TextBlock Text="表示とボタン" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}">・表示: 「ウィンドウに合わせる」「50%（Retina 等倍。くっきり表示）」「100%（ドット等倍）」。マウスカーソルは手元で描きます。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・パスワード入力: Mac のロック画面・ログイン画面に、接続に使ったパスワードを入力して Enter を押します。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・スクリーンショット: Mac の画面を元の解像度で PNG に保存し、クリップボードにもコピーします。</TextBlock>

                <TextBlock Text="制限事項" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}">・クリップボード共有は macOS の画面共有では動作しません（macOS 側の仕様。⚙ の設定はほかの VNC サーバー向け）。</TextBlock>
                <TextBlock Style="{StaticResource Body}">・音声とファイル転送には対応していません。</TextBlock>

                <TextBlock Text="ファイルの場所" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Body}" Text="ログ（パスワードや入力した文字は記録しません）" />
                <TextBox x:Name="LogPathBox" Style="{StaticResource PathBox}" />
                <TextBlock Style="{StaticResource Body}" Text="設定（接続先の履歴・表示倍率など）" Margin="0,8,0,2" />
                <TextBox x:Name="SettingsPathBox" Style="{StaticResource PathBox}" />
                <TextBlock Style="{StaticResource Body}" Text="スクリーンショットの保存先" Margin="0,8,0,2" />
                <TextBox x:Name="ScreenshotPathBox" Style="{StaticResource PathBox}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="保存したパスワード: Windows 資格情報マネージャーの「Windows 資格情報」（rexRemote:ホスト:ポート）" />

                <TextBlock Text="コマンドライン" Style="{StaticResource Heading}" />
                <TextBox x:Name="CommandLineBox" Style="{StaticResource PathBox}" FontFamily="Consolas, Yu Gothic UI" />

                <TextBlock Text="ライセンス" Style="{StaticResource Heading}" />
                <TextBlock x:Name="LicenseText" Style="{StaticResource Body}" />
                <TextBlock Style="{StaticResource Body}">
                    MIT License の条件のもとで、無償で利用・複製・改変・再配布できます。無保証です。
                </TextBlock>

                <TextBlock Style="{StaticResource Body}" Margin="0,18,0,0" Foreground="#6E6E6E" FontSize="11">
                    Apple、Mac、macOS、Apple Remote Desktop は Apple Inc. の商標です。本ソフトウェアは Apple Inc. とは関係ありません。
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
